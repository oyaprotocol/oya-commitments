# Store real values in an ignored .env file or inject them with a secret manager.
OYA_NODE_PRIVATE_KEY=
# Optional HTTP Authorization header values for the providers:
OYA_RPC_AUTHORIZATION=
OYA_IPFS_AUTHORIZATION=
# Needed only by scripts/send-message.mjs, not by the node:
OYA_AGENT_PRIVATE_KEY=
# Needed only by local deploy-logger when creating a new Logger:
LOGGER_DEPLOYER_PK=
